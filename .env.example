# ─────────────────────────────────────────────────────────────
# FinSight360 environment variables
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# NEVER commit your real `.env` file (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────

# App URL — FinSight360 always runs on port 3010 (port 3000 is left alone).
APP_URL="http://localhost:3010"
AUTH_URL="http://localhost:3010"
AUTH_TRUST_HOST="true"

# PostgreSQL connection.
# Docker option (docker-compose.yml) listens on host port 5433:
DATABASE_URL="postgresql://finsight:finsight_dev@localhost:5433/finsight360?schema=public"
# Separate database used only by integration tests (created automatically by docker-compose):
DATABASE_URL_TEST="postgresql://finsight:finsight_dev@localhost:5433/finsight360_test?schema=public"

# Session/JWT signing secret. Generate one with:
#     openssl rand -base64 32
AUTH_SECRET=""

# Session lifetime in hours (default 168 = 7 days).
SESSION_MAX_AGE_HOURS="168"

# Key used to encrypt OAuth tokens (Gmail/Outlook/Groww) at rest. 32 bytes, base64.
# Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Google sign-in (optional — the button appears only when both are set).
# Redirect URI to register in Google Cloud Console:
#     http://localhost:3010/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gmail transaction import (Phase 5). Can be the same Google OAuth client.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""

# Microsoft Outlook transaction import (Phase 5).
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Email delivery for password reset / verification / notifications.
# "console" prints emails to the terminal (development only).
EMAIL_TRANSPORT="console"
EMAIL_FROM="FinSight360 <no-reply@finsight360.local>"

# Require email verification before email/password login is allowed.
REQUIRE_EMAIL_VERIFICATION="false"

# Allow new sign-ups (set to "false" after creating your own account).
ALLOW_REGISTRATION="true"

# Uploaded statements are stored here (private, never served directly; gitignored).
STORAGE_DIR="./storage"

# Set to "true" ONLY behind a reverse proxy you control that overwrites X-Real-IP / X-Forwarded-For.
TRUST_PROXY="false"

# Background mailbox sync while the app runs (minutes; 0 = off).
EMAIL_SYNC_INTERVAL_MINUTES="60"

# Mutual-fund NAV source (AMFI public daily file).
AMFI_NAV_URL="https://www.amfiindia.com/spages/NAVAll.txt"
