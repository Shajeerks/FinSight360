// ─────────────────────────────────────────────────────────────────────────────
// FinSight360 — database schema (PostgreSQL + Prisma)
//
// Conventions
//  • Money: Decimal(18,2). Quantities: Decimal(20,6). Unit prices: Decimal(18,4).
//    Never use Float for money.
//  • Dates that are "calendar dates" (transaction date, EMI due date) use @db.Date.
//    Instants (createdAt, receivedAt) are timestamptz.
//  • Every user-owned row carries userId for authorization filtering + indexes.
//  • Soft delete via deletedAt where users can delete financial records.
//  • Json is used only for raw import payloads / extensible metadata.
//  • Never stored: CVV, PIN, OTP, full card numbers, bank login passwords.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

